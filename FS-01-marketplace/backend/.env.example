# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# S3 (works with AWS S3 or local MinIO from docker-compose)
S3_REGION=us-east-1
S3_BUCKET=marketplace-images
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/marketplace-images

# Stripe Connect (test mode). Leave STRIPE_SECRET_KEY empty to use MOCK payments locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMISSION_PERCENT=10
CURRENCY=usd
