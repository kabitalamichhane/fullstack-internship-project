# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lms?schema=public
REDIS_URL=redis://localhost:6380

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# S3 storage for raw uploads + HLS output (AWS S3 in production, MinIO locally)
S3_REGION=us-east-1
S3_BUCKET=lms-media
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Public base URL that serves the bucket. In production this is your CloudFront distribution,
# e.g. https://d1234abcd.cloudfront.net  — locally it is MinIO.
CDN_BASE_URL=http://localhost:9010/lms-media

# Path to ffmpeg/ffprobe (installed in the worker Docker image)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# LiveKit (free cloud project at livekit.io, or the local dev server in docker-compose)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Stripe test mode. Leave empty to use MOCK payments locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=20
CURRENCY=usd
